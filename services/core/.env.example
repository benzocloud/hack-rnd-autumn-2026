# Documentation only: config.Load reads the environment, not this file.
CORE_LOG_LEVEL=info
CORE_LOG_FORMAT=json
# Local development settings. Supply real credentials via your environment/secret store.
CORE_POSTGRES_HOST=127.0.0.1
CORE_POSTGRES_PORT=5432
CORE_POSTGRES_USER=core
CORE_POSTGRES_PASSWORD=change-me
CORE_POSTGRES_DATABASE=core
CORE_POSTGRES_SSL_MODE=disable
CORE_POSTGRES_MAX_CONNS=10
CORE_POSTGRES_MAX_IDLE_CONNS=2
CORE_POSTGRES_CONNECT_TIMEOUT=5s
CORE_POSTGRES_QUERY_TIMEOUT=5s
CORE_SHUTDOWN_TIMEOUT=10s

# Required only by cmd/core. Provision PEM files outside Git; no plaintext mode.
CORE_GRPC_ADDRESS=127.0.0.1:50052
CORE_AUTH_ADDRESS=127.0.0.1:50053
CORE_AUTH_SERVER_NAME=saldo-auth
CORE_MTLS_CA_FILE=/run/secrets/saldo-ca.pem
CORE_MTLS_CERT_FILE=/run/secrets/saldo-core.pem
CORE_MTLS_KEY_FILE=/run/secrets/saldo-core-key.pem
CORE_AUTH_TIMEOUT=3s

# Set both to enable the durable forecast worker. Missing ML keeps forecast
# creation unavailable; other Core RPCs remain usable. Pin the ML certificate
# DNS name and URI spiffe://saldo.local/ml under the same trusted CA.
CORE_ML_ADDRESS=127.0.0.1:50054
CORE_ML_SERVER_NAME=saldo-ml

# Health-only configuration; use a dedicated Auth database and provision real credentials.
AUTH_ENV=production
AUTH_DATABASE_URL=postgres://auth:REPLACE_ME@db.example/auth?sslmode=verify-full
AUTH_HTTP_ADDRESS=127.0.0.1:8082

# Enable the private Auth RPC listener explicitly, always with mTLS.
# AUTH_GRPC_ADDRESS=127.0.0.1:9092
# AUTH_GRPC_CERT_FILE=/run/secrets/auth-server-cert.pem
# AUTH_GRPC_KEY_FILE=/run/secrets/auth-server-key.pem
# AUTH_GRPC_CA_FILE=/run/secrets/saldo-ca.pem
# Generate two independent random 32-byte keys, encoded as unpadded base64url.
# Supply their real values through the deployment secret store, never Git.
# AUTH_CODE_HMAC_KEY=
# AUTH_CSRF_HMAC_KEY=

# Optional company onboarding/recovery dependency; login/verify do not require Core.
# Reuses the Auth mTLS identity above (certificate must allow clientAuth) and CA.
# AUTH_CORE_ADDRESS=core:50052
# AUTH_CORE_SERVER_NAME=core
# AUTH_CORE_TIMEOUT=2s

# ADR-028: email ownership is mocked only for isolated synthetic test accounts.
# This never enables financial mocks or bypasses passwords, sessions, CSRF or permissions.
# Requires AUTH_ENV=local, the private RPC listener, and an exact .test email allowlist.
AUTH_DEMO_EMAIL_VERIFICATION=false
# AUTH_DEMO_TEST_EMAILS=owner@example.test,financier@example.test

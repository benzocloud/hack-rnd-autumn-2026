# Copy locally; do not commit filled values.
SALDO_E2E_PROJECT=saldo-financial-e2e-local
SALDO_E2E_API_ORIGIN=https://127.0.0.1:8443
SALDO_E2E_FRONTEND_ORIGIN=https://127.0.0.1:3000
SALDO_DATASET_DIR=/absolute/path/to/dataset
SALDO_E2E_EMAIL_DOMAIN=financial-e2e.test
SALDO_E2E_ARTIFACT_DIR=./artifacts
SALDO_E2E_KEEP_STACK=0
# Auth demo only for isolated local allowlist (ADR-028); never enable from browser.
# AUTH_ENV=local
# AUTH_DEMO_EMAIL_VERIFICATION=true
# AUTH_DEMO_TEST_EMAILS=owner+*@financial-e2e.test

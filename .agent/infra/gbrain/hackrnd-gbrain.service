[Unit]
Description=Hackrnd GBrain authenticated MCP
After=network.target

[Service]
Type=simple
User=hackrnd-gbrain
Group=hackrnd-gbrain
WorkingDirectory=/var/lib/hackrnd-gbrain
Environment=GBRAIN_HOME=/var/lib/hackrnd-gbrain
Environment=GBRAIN_NO_AUTOPILOT_INSTALL=1
Environment=GBRAIN_NO_REEMBED=1
Environment=GBRAIN_ALLOW_SHELL_JOBS=0
EnvironmentFile=/etc/hackrnd-gbrain/service.env
ExecStart=/opt/hackrnd-gbrain/bin/gbrain serve --http --bind 127.0.0.1 --port 3131 --surface verbs --public-url https://gbrain.brokebyte.me --suppress-bootstrap-token
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/hackrnd-gbrain
MemoryHigh=1536M
MemoryMax=2048M
TasksMax=96
CPUQuota=150%

[Install]
WantedBy=multi-user.target
